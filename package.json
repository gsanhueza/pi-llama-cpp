{
  "name": "pi-llama-cpp",
  "version": "0.18.2",
  "description": "Pi extension for llama.cpp integration. Supports multiple router/single/legacy/llama-swap servers.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "llama-cpp"
  ],
  "files": [
    "src/**"
  ],
  "author": "Gabriel Sanhueza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsanhueza/pi-llama-cpp.git"
  },
  "homepage": "https://github.com/gsanhueza/pi-llama-cpp#readme",
  "bugs": {
    "url": "https://github.com/gsanhueza/pi-llama-cpp/issues"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.2",
    "@earendil-works/pi-coding-agent": ">=1.0.2",
    "@earendil-works/pi-tui": ">=1.0.2"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "vitest": "^5.0.5"
  }
}
